  "topics": [
    {
      "id": "linear-algebra",
      "name": "Linear algebra",
      "area": "math-foundations",
      "why": "Vectors and matrices are how models represent data and weights.",
      "est_hours": 3
    },
    {
      "id": "calculus-basics",
      "name": "Calculus basics",
      "area": "math-foundations",
      "why": "Training is minimizing a loss, which runs on derivatives.",
      "est_hours": 3
    },
    {
      "id": "probability-stats",
      "name": "Probability & stats",
      "area": "math-foundations",
      "why": "Every model output is a probability; evaluation is statistics.",
      "est_hours": 4
    },
    {
      "id": "numpy",
      "name": "NumPy",
      "area": "python-for-ml",
      "why": "The array library everything else in ML is built on.",
      "est_hours": 2
    },
    {
      "id": "pandas",
      "name": "pandas",
      "area": "python-for-ml",
      "why": "Loading, cleaning and shaping datasets before training.",
      "est_hours": 1.5
    },
    {
      "id": "matplotlib",
      "name": "Matplotlib",
      "area": "python-for-ml",
      "why": "Plotting data and training curves to see what is happening.",
      "est_hours": 0.5
    },
    {
      "id": "supervised-learning",
      "name": "Supervised learning",
      "area": "classical-ml",
      "why": "The train / validate / test loop every later topic builds on.",
      "est_hours": 2
    },
    {
      "id": "regression",
      "name": "Regression",
      "area": "classical-ml",
      "why": "Predicting numbers, and the simplest model to learn training on.",
      "est_hours": 2
    },
    {
      "id": "classification",
      "name": "Classification",
      "area": "classical-ml",
      "why": "Predicting categories, the most common ML task in products.",
      "est_hours": 2
    },
    {
      "id": "model-evaluation",
      "name": "Model evaluation",
      "area": "classical-ml",
      "why": "Knowing whether a model is good, beyond accuracy.",
      "est_hours": 2
    },
    {
      "id": "feature-engineering",
      "name": "Feature engineering",
      "area": "classical-ml",
      "why": "Turning raw data into inputs a model can learn from.",
      "est_hours": 2
    },
    {
      "id": "neural-networks",
      "name": "Neural networks",
      "area": "deep-learning",
      "why": "The building block of modern ML: layers of weighted sums and activations.",
      "est_hours": 3
    },
    {
      "id": "backprop-training",
      "name": "Backprop & training",
      "area": "deep-learning",
      "why": "How networks actually learn, and why training fails.",
      "est_hours": 3
    },
    {
      "id": "cnns",
      "name": "CNNs",
      "area": "deep-learning",
      "why": "Networks for images and other grid-shaped data.",
      "est_hours": 2
    },
    {
      "id": "transformers",
      "name": "Transformers",
      "area": "deep-learning",
      "why": "The architecture behind today's language models.",
      "est_hours": 3
    },
    {
      "id": "experiment-tracking",
